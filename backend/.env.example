# Server configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=replace_with_secure_random_string_in_production
JWT_EXPIRES_IN=24h

# Database Configuration
# Local SQLite database file path (relative to backend folder or absolute)
DB_PATH=./data/researchproof.sqlite

# File Upload Security Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_SUBMISSION=5

# AI Service (Optional - for AI task generation and evaluation)
# Leave blank to use reliable deterministic/manual fallback mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
